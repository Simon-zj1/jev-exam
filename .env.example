# ---- 数据库（可选；未设置时使用内存存储，用于本地演示与测试）----
# DATABASE_URL=postgres://user:pass@host:5432/jev_exam

# ---- 会话签名密钥（生产必须设置）----
SESSION_SECRET=change-me-please-32-bytes-min

# ---- Jev 判定引擎（TypeSafe System One API）----
# TYPESAFE_API_KEY=sk_live_xxx
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest

# ---- 出题 LLM：单 key 方式（推荐，provider 从 key 形状推断）----
# AI_API_KEY=sk-xxx            # sk-ant- Anthropic / sk-or- OpenRouter / AIza Google
#                              # gsk_ Groq / xai- xAI / vck_ Vercel AI Gateway / sk- OpenAI
# AI_PROVIDER=mistral          # key 没有可识别前缀时（mistral/deepseek）显式指定
# AI_BASE_URL=http://localhost:11434/v1   # Ollama / LM Studio / vLLM 等任意 OpenAI 兼容服务
# CHAT_MODEL=gpt-5-mini        # 覆盖默认模型

# ---- 出题 LLM：显式方式（与上面的单 key 二选一，设置了它优先）----
# PLATFORM_LLM_BASE_URL=https://api.openai.com/v1
# PLATFORM_LLM_API_KEY=sk-xxx
# PLATFORM_LLM_MODEL=gpt-5-mini

# ---- 邀请制 ----
# INITIAL_INVITE_CODES=DEV-INVITE
